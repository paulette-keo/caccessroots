# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# Mapbox (used for map view, geocoding, and travel-time)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Workflow email notifications (server-only)
# Create a Resend API key and verify the sender domain before enabling.
RESEND_API_KEY=re_your_api_key
NOTIFICATION_FROM_EMAIL=CAccessRoots <notifications@your-domain.org>
# Optional address for replies from notification recipients.
NOTIFICATION_REPLY_TO=team@your-domain.org
